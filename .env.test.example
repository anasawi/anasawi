# ─── Environnement des tests de bout en bout ─────────────────────────
#
# À copier en `.env.test`, qui n'est pas versionné.
#
# AVERTISSEMENT : les tests VIDENT la base avant chaque série. L'adresse
# ci-dessous doit désigner la branche Neon « test », et elle seule. Le script
# de remise à plat refuse de s'exécuter s'il reconnaît une branche de
# développement, de préproduction ou de production — mais ne comptez pas
# dessus : vérifiez vous-même.

# console.neon.tech → branche « test » → Connect → chaîne pooled
E2E_DATABASE_URL=""

# Mot de passe du compte administrateur de test (12 caractères minimum).
# Il n'ouvre rien d'autre que la base de test : inventez-le, ne réutilisez
# aucun mot de passe existant.
E2E_ADMIN_PASSWORD=""

# Port du serveur lancé par Playwright — distinct de 3000 pour ne pas
# perturber un `npm run dev` en cours.
E2E_PORT="3100"
