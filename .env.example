# ─── Base de données (Neon PostgreSQL) ───────────────────────────────
# https://console.neon.tech → Connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/amaswi?sslmode=require"

# ─── Authentification (Auth.js v5) ───────────────────────────────────
# Générer avec : openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ─── Stockage des médias ─────────────────────────────────────────────
# Aucune clé nécessaire : sur Netlify, les images vont dans Netlify Blobs
# (provisionné automatiquement) ; en local, dans le dossier .storage/.
# Décommenter uniquement pour forcer un pilote : "netlify" ou "local".
# MEDIA_STORAGE="local"

# ─── Emails du formulaire de contact (Resend) ────────────────────────
# Optionnel : sans clé, les messages sont enregistrés en base sans notification.
RESEND_API_KEY=""
CONTACT_NOTIFY_TO="annewinzenried@orange.fr"
CONTACT_NOTIFY_FROM="ANASAWI <contact@anasawi.com>"

# ─── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://anasawi.com"
