# ─── Base de données (Neon PostgreSQL) ───────────────────────────────
# https://console.neon.tech → Connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/amaswi?sslmode=require"

# ─── Authentification (Auth.js v5) ───────────────────────────────────
# Générer avec : openssl rand -base64 32
# Sert aussi de racine aux clés dérivées (chiffrement des jetons
# d'invitation, sel des empreintes d'IP) : le changer invalide les
# sessions ouvertes ET rend illisibles les liens d'invitation en cours.
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ─── Stockage des médias ─────────────────────────────────────────────
# Aucune clé nécessaire : sur Netlify, les images vont dans Netlify Blobs
# (provisionné automatiquement) ; en local, dans le dossier .storage/.
# Décommenter uniquement pour forcer un pilote : "netlify" ou "local".
# MEDIA_STORAGE="local"

# ─── Emails du formulaire de contact (Resend) ────────────────────────
# Optionnel : sans clé, les messages sont enregistrés en base sans notification.
RESEND_API_KEY=""
CONTACT_NOTIFY_TO="prenom.nom@example.com"
CONTACT_NOTIFY_FROM="ANASAWI <contact@example.com>"

# ─── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://anasawi.com"

# ─── Hébergeur (Netlify) ─────────────────────────────────────────────
# Renseignée par Netlify à chaque build : "production", "deploy-preview",
# "branch-deploy"… Hors production, robots.txt interdit l'indexation.
# Ne pas définir en local.
# CONTEXT="production"

# ─── Build ───────────────────────────────────────────────────────────
# Dossier de sortie de `next build`. Les scripts de validation construisent
# dans un dossier à part pour ne pas écraser celui de `next dev` ; Netlify
# et le dev gardent `.next` (défaut).
# NEXT_DIST_DIR=".next-build"

# ─── Scripts de copie de contenu (copier-le-contenu.command) ─────────
# Bases cibles de `db:copier-contenu` (CIBLE=preprod | prod), et accès
# Netlify pour y envoyer aussi les médias. Jamais lues par le site.
# PREPROD_DATABASE_URL=""
# PROD_DATABASE_URL=""
# NETLIFY_AUTH_TOKEN=""
# NETLIFY_SITE_ID=""
